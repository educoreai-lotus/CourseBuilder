# Course Builder Backend — environment variables

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coursebuilder

# CORS / frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,https://course-builder-alpha-nine.vercel.app

# Coordinator (required in production for JWT validation)
COORDINATOR_URL=http://localhost:5000
# COORDINATOR_API_URL=http://localhost:5000

# Service identity for Coordinator auth validation envelope (must match Coordinator registration)
AUTH_REQUESTER_SERVICE=course-builder-service
SERVICE_NAME=course-builder-service

# Inter-service signing
# PRIVATE_KEY=
# COORDINATOR_PUBLIC_KEY=

# Auth (Coordinator → nAuth validation timeout; default 30000ms)
AUTH_VALIDATION_TIMEOUT_MS=30000

# Local dev/test only — never enable in production
ENABLE_MOCK_AUTH=true

# TEMPORARY: Railway idle-timeout diagnostic (remove after experiment)
# RAILWAY_TIMEOUT_TEST_ENABLED=true
# RAILWAY_TIMEOUT_TEST_KEY=

# Additive durable personalized generation (default OFF — keep unset or false in all envs)
PERSONALIZED_ASYNC_GENERATION_ENABLED=false

# Chunked Trainer Publish size limits (optional; defaults are conservative for 1-replica sync FINALIZE)
# Decompressed JSON cap for CHUNKED FINALIZE only (default 32MiB, hard ceiling 128MiB). Legacy compressed stays 5MiB.
# TRAINER_PUBLISH_CHUNKED_MAX_DECOMPRESSED_BYTES=33554432
# Reassembled gzip bytes per transfer (default 32MiB, hard ceiling 32MiB)
# TRAINER_PUBLISH_MAX_TRANSFER_DECODED_BYTES=33554432
# Concurrent in-memory transfers (default 4; raise only with known RAM headroom)
# TRAINER_PUBLISH_MAX_CONCURRENT_TRANSFERS=4

# Legacy (replaced by Coordinator/nAuth validation)
# AUTH_JWT_SECRET=
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_DISABLED=true
